{
	"schemaVersion": 1,
	"id": "clipshot",
	"version": "${version}",
	"name": "ClipShot",
	"description": "A lightweight mod that copies F2 screenshots to the clipboard and notifies you of this in chat.",
	"authors": ["aksdes"],
	"license": "GPL-3.0",
	"icon": "assets/clipshot/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.aksdes.clipshot.ClipShot"],
		"modmenu": ["com.aksdes.clipshot.compat.ModMenuIntegration"]
	},
	"mixins": [
		{
			"config": "clipshot.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25"
	},
	"suggests": {
		"modmenu": "*"
	}
}
